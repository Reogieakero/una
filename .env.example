# Shared Supabase project (single source of truth — see packages/supabase-client/src/config.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=your-project-ref
# Per-app overrides (mobile reads the same two NEXT_PUBLIC_* via expo-constants / .env)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Prisma (@dorsu/db, trusted server contexts only — never expose service keys client-side).
# DATABASE_URL uses the Supabase pooler (port 6543, ?pgbouncer=true); DIRECT_URL is
# the direct Postgres URL (port 5432) for `prisma db push` / schema introspection.
# Find both in Supabase Dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "db:types": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    },
    "db:validate": {},
    "db:format": {},
    "db:push": {
      "cache": false
    },
    "db:pull": {
      "cache": false
    }
  }
}

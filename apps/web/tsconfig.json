{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./*"],
      "@dorsu/shared-types": ["../../packages/shared-types/src"],
      "@dorsu/shared-schemas": ["../../packages/shared-schemas/src"],
      "@dorsu/shared-services": ["../../packages/shared-services/src"],
      "@dorsu/supabase-client": ["../../packages/supabase-client/src"],
      "@dorsu/db": ["../../packages/db/src"],
      "@dorsu/ui-tokens": ["../../packages/ui-tokens/src"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}

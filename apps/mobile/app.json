{
  "expo": {
    "name": "Chekie Student",
    "slug": "dorsu-chekie-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dorsu-mental",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8E1",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.ph.dorsu.chekie"
    },
    "android": {
      "package": "edu.ph.dorsu.chekie",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFF6FF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EFF6FF"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Chekie to access your photos so you can choose a profile picture."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "8ccde26c-b329-4e4c-87af-f4bd396f748e"
      },
      "supabaseUrl": "https://xueqvjozlyayggsyfzsq.supabase.co",
      "supabaseAnonKey": "sb_publishable_c5tj2KMhkkbArWvWSF5tEQ_42rGdva6"
    },
    "owner": "akeroshii"
  }
}

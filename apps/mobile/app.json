{
  "expo": {
    "name": "Chekie Student",
    "slug": "dorsu-chekie-student",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "dorsu-mental",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFF8E1",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "edu.ph.dorsu.chekie"
    },
    "android": {
      "package": "edu.ph.dorsu.chekie",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EFF6FF"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EFF6FF"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png"
        }
      ],
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
